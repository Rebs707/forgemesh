  <rdf:Description rdf:about="http://mesh.local/ontology/openflights#hasActiveStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has active status</rdfs:label>
    <rdfs:label xml:lang="en">has airline ID</rdfs:label>
    <rdfs:label xml:lang="en">has airline name</rdfs:label>
    <rdfs:label xml:lang="en">has airline alias</rdfs:label>
    <rdfs:label xml:lang="en">has airline IATA code</rdfs:label>
    <rdfs:label xml:lang="en">has airline ICAO code</rdfs:label>
    <rdfs:label xml:lang="en">has airline callsign</rdfs:label>
    <rdfs:label xml:lang="en">has airline country</rdfs:label>
    <rdfs:comment xml:lang="en">Links an airline to its operational status.</rdfs:comment>
    <rdfs:comment xml:lang="en">The unique identifier for an airline.</rdfs:comment>
    <rdfs:comment xml:lang="en">The name of the airline.</rdfs:comment>
    <rdfs:comment xml:lang="en">An alternative name for the airline.</rdfs:comment>
    <rdfs:comment xml:lang="en">The IATA code for the airline.</rdfs:comment>
    <rdfs:comment xml:lang="en">The ICAO code for the airline.</rdfs:comment>
    <rdfs:comment xml:lang="en">The callsign used by the airline.</rdfs:comment>
    <rdfs:comment xml:lang="en">The country where the airline is based.</rdfs:comment>
    <rdfs:domain rdf:resource="http://mesh.local/ontology/openflights#Airline"/>
    <rdfs:range rdf:resource="http://mesh.local/ontology/openflights#ActiveStatus"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:subPropertyOf rdf:resource="http://mesh.local/ontology/openflights#hasAirlineIdentifier"/>
    <rdfs:subPropertyOf rdf:resource="http://mesh.local/ontology/openflights#hasAirlineLabel"/>
    <fm:sourceForeignKey>raw_airlines.active -&gt; ActiveStatus</fm:sourceForeignKey>
  </rdf:Description>
