  <rdf:Description rdf:about="http://forgemesh.ai/ontology#incompleteReference">
    <rdfs:label xml:lang="en">incomplete reference</rdfs:label>
    <rdfs:comment xml:lang="en">Records a null or unresolvable object-property FK on this individual. The value is the property URI that could not be resolved. Presence of this triple means the individual is structurally incomplete at source — it was not a materialiser error.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
  </rdf:Description>
