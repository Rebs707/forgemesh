  <rdf:Description rdf:about="http://forgemesh.ai/ontology#incompleteReference">
    <rdfs:comment xml:lang="en">Records a null object-property FK on this individual. The value is the property URI that could not be resolved. Presence of this triple means the individual is structurally incomplete at source (the FK was NULL) — it was not a materialiser error. C5 incompleteness_reconciliation counts these against gold-table null FK values.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AnnotationProperty"/>
    <rdfs:label xml:lang="en">incomplete reference</rdfs:label>
  </rdf:Description>
