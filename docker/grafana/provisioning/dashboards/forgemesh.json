{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" },
    { "type": "panel", "id": "logs", "name": "Logs", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "ForgeMesh — all Docker container logs + webapp query/token analytics",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "All Containers",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Live tail of all Docker container stdout/stderr. Filter by service using the variable above.",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "fontSize": "xs"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{job=\"docker\", service=~\"$service\"} |= \"$search\"",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Container Logs — $service",
      "type": "logs"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 11 },
      "id": 101,
      "title": "Webapp — Requests",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "All HTTP requests logged by webapp.request",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 2,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "fontSize": "xs"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{job=\"forgemesh\", logger=\"webapp.request\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "HTTP Requests",
      "type": "logs"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Rate of incoming requests (5m rolling)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(rate({job=\"forgemesh\", logger=\"webapp.request\"} |= \"received\" [5m]))",
          "legendFormat": "requests/s",
          "refId": "A"
        }
      ],
      "title": "Request Rate",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Request latency extracted from duration_ms field (webapp structured logs)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10 },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "id": 4,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum_over_time({job=\"forgemesh\", logger=\"webapp.request\"} | json | duration_ms != \"\" | unwrap duration_ms [5m]) / count_over_time({job=\"forgemesh\", logger=\"webapp.request\"} | json | duration_ms != \"\" [5m])",
          "legendFormat": "avg latency ms",
          "refId": "A"
        }
      ],
      "title": "Avg Request Latency",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 26 },
      "id": 102,
      "title": "Webapp — Query Lifecycle",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Query received / generated / completed / failed events",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 27 },
      "id": 5,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "fontSize": "xs"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{job=\"forgemesh\", logger=\"webapp.query\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Query Events",
      "type": "logs"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "LLM token consumption over time broken down by prompt vs completion",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 35 },
      "id": 6,
      "timeFrom": "now/d",
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["sum"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum by (mode) (sum_over_time({job=\"forgemesh\", event=\"completed\"} | json | prompt_tokens != \"\" | unwrap prompt_tokens [1h]))",
          "legendFormat": "prompt ({{mode}})",
          "refId": "A"
        },
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum by (mode) (sum_over_time({job=\"forgemesh\", event=\"completed\"} | json | completion_tokens != \"\" | unwrap completion_tokens [1h]))",
          "legendFormat": "completion ({{mode}})",
          "refId": "B"
        }
      ],
      "title": "LLM Token Usage",
      "type": "timeseries"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Total tokens today (midnight to now)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 100000 },
            { "color": "red", "value": 500000 }
          ]},
          "unit": "short", "mappings": []
        },
        "overrides": []
      },
      "gridPos": { "h": 2, "w": 12, "x": 12, "y": 35 },
      "id": 7,
      "options": {
        "colorMode": "background", "graphMode": "none",
        "justifyMode": "center", "orientation": "auto",
        "reduceOptions": { "calcs": ["last"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "sum(sum_over_time({job=\"forgemesh\", event=\"completed\"} | json | total_tokens != \"\" | unwrap total_tokens [$__range]))",
        "legendFormat": "", "refId": "A"
      }],
      "timeFrom": "now/d",
      "title": "Tokens — Today",
      "type": "stat"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Total tokens this week",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 500000 },
            { "color": "red", "value": 2000000 }
          ]},
          "unit": "short", "mappings": []
        },
        "overrides": []
      },
      "gridPos": { "h": 2, "w": 12, "x": 12, "y": 37 },
      "id": 71,
      "options": {
        "colorMode": "background", "graphMode": "none",
        "justifyMode": "center", "orientation": "auto",
        "reduceOptions": { "calcs": ["last"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "sum(sum_over_time({job=\"forgemesh\", event=\"completed\"} | json | total_tokens != \"\" | unwrap total_tokens [$__range]))",
        "legendFormat": "", "refId": "A"
      }],
      "timeFrom": "now/w",
      "title": "Tokens — This Week",
      "type": "stat"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Total tokens this month",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 2000000 },
            { "color": "red", "value": 10000000 }
          ]},
          "unit": "short", "mappings": []
        },
        "overrides": []
      },
      "gridPos": { "h": 3, "w": 12, "x": 12, "y": 39 },
      "id": 72,
      "options": {
        "colorMode": "background", "graphMode": "none",
        "justifyMode": "center", "orientation": "auto",
        "reduceOptions": { "calcs": ["last"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [{
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "expr": "sum(sum_over_time({job=\"forgemesh\", event=\"completed\"} | json | total_tokens != \"\" | unwrap total_tokens [$__range]))",
        "legendFormat": "", "refId": "A"
      }],
      "timeFrom": "now/M",
      "title": "Tokens — This Month",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 42 },
      "id": 103,
      "title": "Webapp — Pipeline & Errors",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "Pipeline subprocess output captured by the webapp",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 43 },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "fontSize": "xs"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{job=\"forgemesh\", logger=\"pipeline.subprocess\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Pipeline Subprocess Logs",
      "type": "logs"
    },

    {
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "description": "ERROR and WARNING level events across the webapp",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 51 },
      "id": 9,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true,
        "fontSize": "xs"
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{job=\"forgemesh\", level=~\"ERROR|WARNING\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Errors & Warnings",
      "type": "logs"
    }

  ],

  "refresh": "10s",
  "schemaVersion": 38,
  "tags": ["forgemesh", "docker", "loki"],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "DS_LOKI",
        "options": [],
        "query": "loki",
        "refresh": 1,
        "type": "datasource"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "definition": "label_values({job=\"docker\"}, service)",
        "hide": 0,
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "service",
        "options": [],
        "query": "label_values({job=\"docker\"}, service)",
        "refresh": 2,
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "selected": false, "text": "", "value": "" },
        "hide": 0,
        "label": "Search",
        "name": "search",
        "options": [{ "selected": true, "text": "", "value": "" }],
        "query": "",
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "ForgeMesh",
  "uid": "forgemesh-main",
  "version": 1
}
