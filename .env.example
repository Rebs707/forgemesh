# ForgeMesh configuration. Copy to .env and set LLM_API_KEY:
#
#   cp .env.example .env
#
# That's all the quick start needs. Dataset-specific settings (database URLs,
# ontology, Fuseki dataset) come from projects/<name>.yaml when you pass
# --project <name> to main.py, web_app.py or mcp_server.py.

# Project the web app and MCP server start on when no --project is given.
# synthea runs on the bundled sample; mimic needs the MIMIC-III demo (see datasets/mimic/).
# DEFAULT_PROJECT=synthea

# ── Docker infrastructure (docker compose reads this file) ────────────────────
# Defaults shown. The MySQL password must match the URLs in projects/*.yaml.
# MYSQL_ROOT_PASSWORD=password
# FORGEMESH_MYSQL_PORT=3307         # host port for MySQL
# FORGEMESH_FUSEKI_PORT=3030        # host port for Fuseki
# FORGEMESH_MYSQL_VOLUME=forgemesh_mysql_data
# FORGEMESH_FUSEKI_VOLUME=forgemesh_fuseki_data
# COMPOSE_PROJECT_NAME=forgemesh   # change (with the volumes/ports) to run a second, independent stack
#
# If you change the ports, point ForgeMesh at them too:
# FORGEMESH_DB_HOST=127.0.0.1       # rewrites host:port in every project's DB URLs
# FORGEMESH_DB_PORT=3307
# FUSEKI_URL=http://localhost:3030

# ── Without a project (--env mode, your own database) ────────────────────────
# DATABASE_URL=mysql+pymysql://root:password@localhost:3307/bronze_db
# ONTOLOGY_PATH=owl/your_ontology.owl   # unset = generate one with --phases seed,full

# ── LLM backend (vendor-agnostic) ─────────────────────────────────────────────
# Settings are named for the ROLE, not the vendor. ForgeMesh talks to any
# OpenAI-compatible endpoint. (Legacy OPENAI_* names still work as aliases.)
#   LLM_MODEL    → ontology generation + mapping/LLMStrategy + proof narrator
#   QUERY_MODEL  → NL→SQL / NL→SPARQL query engines + MCP
#   LLM_BASE_URL → endpoint; unset = cloud OpenAI, set = local/self-hosted
#
# Cloud OpenAI (default):
LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# QUERY_MODEL=gpt-4o
# LLM_ENABLED=true
#
# Fully local / air-gapped via Ollama (http://localhost:11434/v1).
# LLM_BASE_URL is what flips the backend.
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama             # any non-empty string; local servers ignore it
# LLM_MODEL=qwen2.5:32b-instruct # heavy reasoning (ontology gen / mapping)
# QUERY_MODEL=qwen2.5:14b-instruct  # interactive queries
# Optional per-pass split for the iterative ontology generator (unset = LLM_MODEL):
# ONTOLOGY_GEN_MODEL=qwen2.5:32b-instruct
# ONTOLOGY_JUDGE_MODEL=qwen2.5:14b-instruct
# Keep this empty so the cloud Claude provider is never selected:
# ANTHROPIC_API_KEY=
# QUERY_PROVIDER=openai          # must be "openai" (not "claude_code") for local

# Mapping thresholds (optional — these override settings.py defaults)
# AUTO_CONFIRM_THRESHOLD=
# FUZZY_MATCH_THRESHOLD=
# SAMPLE_SIZE=
# NULL_RATE_WARNING_THRESHOLD=
# LOW_CARDINALITY_THRESHOLD=
